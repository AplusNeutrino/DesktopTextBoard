<Window x:Class="DesktopTextBoard.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Text Board"
        Width="1240"
        Height="780"
        MinWidth="1040"
        MinHeight="660"
        Background="{StaticResource AppBackgroundBrush}">
  <DockPanel TextElement.Foreground="#F3F5F7">
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Desktop Text Board" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="编辑内容会自动同步到桌面透明小组件" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="已就绪" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ToolbarButton}" Content="B" FontWeight="Bold" Click="BoldButton_Click" ToolTip="加粗"/>
          <Button Style="{StaticResource ToolbarButton}" Content="I" FontStyle="Italic" Click="ItalicButton_Click" ToolTip="斜体"/>
          <Button Style="{StaticResource ToolbarButton}" Content="U" Click="UnderlineButton_Click" ToolTip="下划线"/>
          <Button Style="{StaticResource ToolbarButton}" Content="S" Click="StrikethroughButton_Click" ToolTip="删除线"/>
          <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="8,0"/>
          <Button Style="{StaticResource ToolbarButton}" Content="项目符号" Click="BulletsButton_Click"/>
          <Button Style="{StaticResource ToolbarButton}" Content="编号" Click="NumbersButton_Click"/>
          <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="8,0"/>
          <Button Style="{StaticResource ToolbarButton}" Content="左对齐" Click="AlignLeftButton_Click"/>
          <Button Style="{StaticResource ToolbarButton}" Content="居中" Click="AlignCenterButton_Click"/>
          <Button Style="{StaticResource ToolbarButton}" Content="右对齐" Click="AlignRightButton_Click"/>
          <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="8,0"/>
          <TextBlock Text="字号" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="8,0,4,0"/>
          <ComboBox x:Name="FontSizeBox" Width="72" SelectionChanged="FontSizeBox_SelectionChanged"/>
          <TextBlock Text="文字" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="8,0,4,0"/>
          <ComboBox x:Name="TextColorBox" Width="110" SelectionChanged="TextColorBox_SelectionChanged"/>
          <TextBlock Text="高亮" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="8,0,4,0"/>
          <ComboBox x:Name="HighlightColorBox" Width="110" SelectionChanged="HighlightColorBox_SelectionChanged"/>
          <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="8,0"/>
          <Button Style="{StaticResource PrimaryButton}" Content="立即保存" Click="SaveNowButton_Click"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="小组件" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="管理桌面上的透明文字板" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="新增小组件" Click="AddWidgetButton_Click"/>
            <Button Content="复制当前" Click="DuplicateWidgetButton_Click"/>
            <Button Style="{StaticResource DangerButton}" Content="删除当前" Click="DeleteWidgetButton_Click"/>
          </StackPanel>
          <ListBox x:Name="WidgetList"
                   Background="#11161D"
                   Foreground="#F3F5F7"
                   BorderBrush="{StaticResource BorderBrush}"
                   Padding="4"
                   DisplayMemberPath="Name"
                   SelectionChanged="WidgetList_SelectionChanged"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource CanvasBackgroundBrush}" Padding="22">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid>
            <Border x:Name="CanvasShell"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,18"
                    SnapsToDevicePixels="True">
              <Grid x:Name="CanvasHost"/>
            </Border>
          </Grid>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="当前选中小组件" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,3,0,12"/>

            <Expander Header="基础" IsExpanded="True">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="名称"/>
                <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="模式"/>
                <ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_SelectionChanged"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="行数"/>
                    <TextBox x:Name="RowsBox"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="列数"/>
                    <TextBox x:Name="ColumnsBox"/>
                  </StackPanel>
                </Grid>
                <Button Content="应用网格" Click="ApplyGridButton_Click"/>

                <CheckBox x:Name="LockCheck" Content="锁定桌面交互" Margin="0,10,0,8" Checked="LockCheck_Changed" Unchecked="LockCheck_Changed"/>
              </StackPanel>
            </Expander>

            <Expander Header="显示器" IsExpanded="True">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="目标显示器"/>
                <ComboBox x:Name="MonitorCombo" DisplayMemberPath="DisplayName"/>
                <Button Content="移动到该显示器" Click="MoveToMonitorButton_Click"/>
              </StackPanel>
            </Expander>

            <Expander Header="外观" IsExpanded="True">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="预设"/>
                <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_SelectionChanged"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="背景颜色"/>
                <TextBox x:Name="BackgroundColorBox" LostFocus="AppearanceBox_LostFocus"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="背景透明度"/>
                <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="1" ValueChanged="AppearanceSlider_ValueChanged"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="边框颜色"/>
                <TextBox x:Name="BorderColorBox" LostFocus="AppearanceBox_LostFocus"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="边框透明度"/>
                <Slider x:Name="BorderOpacitySlider" Minimum="0" Maximum="1" ValueChanged="AppearanceSlider_ValueChanged"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="边框粗细"/>
                <Slider x:Name="BorderThicknessSlider" Minimum="0" Maximum="8" ValueChanged="AppearanceSlider_ValueChanged"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="圆角"/>
                <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="32" ValueChanged="AppearanceSlider_ValueChanged"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="内边距"/>
                <Slider x:Name="PaddingSlider" Minimum="0" Maximum="36" ValueChanged="AppearanceSlider_ValueChanged"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="默认文字颜色"/>
                <TextBox x:Name="DefaultTextColorBox" LostFocus="AppearanceBox_LostFocus"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="默认字号"/>
                <Slider x:Name="DefaultFontSizeSlider" Minimum="10" Maximum="32" ValueChanged="AppearanceSlider_ValueChanged"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
