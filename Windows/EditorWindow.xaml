<Window x:Class="DesktopTextBoard.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Text Board"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Background="#15181D">
  <DockPanel TextElement.Foreground="#F3F5F7">
    <ToolBar DockPanel.Dock="Top" Background="#20232A">
      <Button Content="B" FontWeight="Bold" Click="BoldButton_Click" ToolTip="Bold"/>
      <Button Content="I" FontStyle="Italic" Click="ItalicButton_Click" ToolTip="Italic"/>
      <Button Content="U" Click="UnderlineButton_Click" ToolTip="Underline"/>
      <Button Content="S" Click="StrikethroughButton_Click" ToolTip="Strikethrough"/>
      <Separator/>
      <Button Content="Bullets" Click="BulletsButton_Click"/>
      <Button Content="Numbers" Click="NumbersButton_Click"/>
      <Separator/>
      <Button Content="Left" Click="AlignLeftButton_Click"/>
      <Button Content="Center" Click="AlignCenterButton_Click"/>
      <Button Content="Right" Click="AlignRightButton_Click"/>
      <Separator/>
      <TextBlock Text="Size" VerticalAlignment="Center" Margin="8,0,4,0"/>
      <ComboBox x:Name="FontSizeBox" Width="72" SelectionChanged="FontSizeBox_SelectionChanged"/>
      <TextBlock Text="Text" VerticalAlignment="Center" Margin="8,0,4,0"/>
      <ComboBox x:Name="TextColorBox" Width="110" SelectionChanged="TextColorBox_SelectionChanged"/>
      <TextBlock Text="Highlight" VerticalAlignment="Center" Margin="8,0,4,0"/>
      <ComboBox x:Name="HighlightColorBox" Width="110" SelectionChanged="HighlightColorBox_SelectionChanged"/>
      <Separator/>
      <Button Content="Save now" Click="SaveNowButton_Click"/>
    </ToolBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#20232A" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Widgets" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Add widget" Click="AddWidgetButton_Click"/>
            <Button Content="Duplicate" Click="DuplicateWidgetButton_Click"/>
            <Button Content="Delete" Click="DeleteWidgetButton_Click"/>
          </StackPanel>
          <ListBox x:Name="WidgetList"
                   Background="#15181D"
                   Foreground="#F3F5F7"
                   BorderBrush="#3B4049"
                   DisplayMemberPath="Name"
                   SelectionChanged="WidgetList_SelectionChanged"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="#111318" Padding="18">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid>
            <Border x:Name="CanvasShell"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    BorderBrush="#3B4049"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,18">
              <Grid x:Name="CanvasHost"/>
            </Border>
          </Grid>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Background="#20232A" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Widget Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <TextBlock Text="Name"/>
            <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"/>

            <TextBlock Text="Mode"/>
            <ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_SelectionChanged"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Rows"/>
                <TextBox x:Name="RowsBox"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Columns"/>
                <TextBox x:Name="ColumnsBox"/>
              </StackPanel>
            </Grid>
            <Button Content="Apply grid" Click="ApplyGridButton_Click"/>

            <CheckBox x:Name="LockCheck" Content="Locked" Margin="0,8,0,8" Checked="LockCheck_Changed" Unchecked="LockCheck_Changed"/>

            <TextBlock Text="Monitor"/>
            <ComboBox x:Name="MonitorCombo" DisplayMemberPath="DisplayName"/>
            <Button Content="Move to monitor" Click="MoveToMonitorButton_Click"/>

            <TextBlock Text="Appearance preset" Margin="0,10,0,0"/>
            <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_SelectionChanged"/>

            <TextBlock Text="Background color"/>
            <TextBox x:Name="BackgroundColorBox" LostFocus="AppearanceBox_LostFocus"/>
            <TextBlock Text="Background opacity"/>
            <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="1" ValueChanged="AppearanceSlider_ValueChanged"/>

            <TextBlock Text="Border color"/>
            <TextBox x:Name="BorderColorBox" LostFocus="AppearanceBox_LostFocus"/>
            <TextBlock Text="Border opacity"/>
            <Slider x:Name="BorderOpacitySlider" Minimum="0" Maximum="1" ValueChanged="AppearanceSlider_ValueChanged"/>

            <TextBlock Text="Border thickness"/>
            <Slider x:Name="BorderThicknessSlider" Minimum="0" Maximum="8" ValueChanged="AppearanceSlider_ValueChanged"/>

            <TextBlock Text="Corner radius"/>
            <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="32" ValueChanged="AppearanceSlider_ValueChanged"/>

            <TextBlock Text="Padding"/>
            <Slider x:Name="PaddingSlider" Minimum="0" Maximum="36" ValueChanged="AppearanceSlider_ValueChanged"/>

            <TextBlock Text="Default text color"/>
            <TextBox x:Name="DefaultTextColorBox" LostFocus="AppearanceBox_LostFocus"/>

            <TextBlock Text="Default font size"/>
            <Slider x:Name="DefaultFontSizeSlider" Minimum="10" Maximum="32" ValueChanged="AppearanceSlider_ValueChanged"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
