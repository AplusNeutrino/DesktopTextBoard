<Window x:Class="DesktopTextBoard.Windows.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Desktop Text Board Widget"
        Width="420"
        Height="320"
        MinWidth="160"
        MinHeight="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False">
  <Grid x:Name="Root" MouseLeftButtonDown="Root_MouseLeftButtonDown">
    <Border x:Name="ShellBorder" SnapsToDevicePixels="True">
      <Grid x:Name="ContentGrid" ClipToBounds="True"/>
    </Border>

    <Border x:Name="UnlockedOutline"
            BorderBrush="#88FFFFFF"
            BorderThickness="1"
            Background="Transparent"
            Visibility="Collapsed"/>

    <primitives:Thumb x:Name="TopLeftHandle"
                      Width="12"
                      Height="12"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Cursor="SizeNWSE"
                      DragDelta="TopLeftHandle_DragDelta"
                      Visibility="Collapsed"/>
    <primitives:Thumb x:Name="TopRightHandle"
                      Width="12"
                      Height="12"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Cursor="SizeNESW"
                      DragDelta="TopRightHandle_DragDelta"
                      Visibility="Collapsed"/>
    <primitives:Thumb x:Name="BottomLeftHandle"
                      Width="12"
                      Height="12"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      Cursor="SizeNESW"
                      DragDelta="BottomLeftHandle_DragDelta"
                      Visibility="Collapsed"/>
    <primitives:Thumb x:Name="BottomRightHandle"
                      Width="12"
                      Height="12"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Cursor="SizeNWSE"
                      DragDelta="BottomRightHandle_DragDelta"
                      Visibility="Collapsed"/>
  </Grid>
</Window>
