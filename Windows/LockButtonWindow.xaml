<Window x:Class="DesktopTextBoard.Windows.LockButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="44"
        Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False">
  <Button x:Name="LockButton"
          Click="LockButton_Click"
          Padding="0"
          Margin="0"
          FontSize="12"
          FontWeight="SemiBold"
          BorderThickness="1"
          Opacity="0.72"/>
</Window>
