<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AkashaNotes.ico</ApplicationIcon>
    <AssemblyName>AkashaNotes</AssemblyName>
    <RootNamespace>DesktopTextBoard</RootNamespace>
    <Version>0.1.2</Version>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <AssemblyTitle>阿卡夏便笺 Akasha Notes</AssemblyTitle>
    <Title>阿卡夏便笺 Akasha Notes</Title>
    <Product>阿卡夏便笺 Akasha Notes</Product>
    <Company>阿卡夏便笺 Akasha Notes</Company>
    <FileDescription>阿卡夏便笺 Akasha Notes</FileDescription>
    <Description>Transparent desktop notes and rich text widgets for Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\AkashaNotes.ico" />
    <Content Include="Assets\AkashaNotes.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\AkashaNotesTaskbar.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
