<Application x:Class="DesktopTextBoard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#20232A"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#2A2E36"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3F5F7"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#AAB0B8"/>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,3,0,8"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,3,0,8"/>
      <Setter Property="Padding" Value="5,3"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,3,0,8"/>
    </Style>
  </Application.Resources>
</Application>
